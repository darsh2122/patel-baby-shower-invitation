RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Baby Shower RSVP <rsvp@your-verified-domain.example>
# Optional URL override; normally inferred from deployment
NEXT_PUBLIC_SITE_URL=http://localhost:3000